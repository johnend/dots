#######################################
# Nerd Font detection (cached per shell) with emoji fallback.
# Glyphs/colors sourced from common/.config/nvim/lua/config/icons.lua and
# ANSI colors follow the Rose Pine palette (linux/common/.config/waybar/rose-pine.css).
#######################################
typeset -g _ZF_NERD_FONT=""
function _zf_has_nerd_font() {
  if [[ -z "$_ZF_NERD_FONT" ]]; then
    if command -v fc-list &>/dev/null && fc-list 2>/dev/null | grep -qi "nerd font"; then
      _ZF_NERD_FONT=1
    elif [[ "$OSTYPE" == darwin* ]] && find /Library/Fonts "$HOME/Library/Fonts" -iname "*Nerd Font*" -print -quit 2>/dev/null | grep -q .; then
      _ZF_NERD_FONT=1
    else
      _ZF_NERD_FONT=0
    fi
  fi
  [[ "$_ZF_NERD_FONT" == 1 ]]
}

_ZF_RED=$'\033[38;2;235;111;146m'
_ZF_YELLOW=$'\033[38;2;246;193;119m'
_ZF_GREEN=$'\033[38;2;49;116;143m'
_ZF_BLUE=$'\033[38;2;156;207;216m'
_ZF_RESET=$'\033[0m'

if _zf_has_nerd_font; then
  ICON_CASK="${_ZF_BLUE}"$'\ueb29'"${_ZF_RESET}"
  ICON_PACKAGE="${_ZF_BLUE}"$'\ueb29'"${_ZF_RESET}"
  ICON_INSTALL="${_ZF_BLUE}"$'\ueac2'"${_ZF_RESET}"
  ICON_TRUST="${_ZF_YELLOW}"$'\uea75'"${_ZF_RESET}"
  ICON_ERROR="${_ZF_RED}"$'\uea87'"${_ZF_RESET}"
  ICON_SUCCESS="${_ZF_GREEN}"$'\ueab2'"${_ZF_RESET}"
  ICON_WARN="${_ZF_YELLOW}"$'\uea6c'"${_ZF_RESET}"
  ICON_GRADLE="${_ZF_BLUE}"$'\ue7f2'"${_ZF_RESET}"
  ICON_WAVE="${_ZF_BLUE}"$'\U000f1821'"${_ZF_RESET}"
  ICON_UNINSTALL="${_ZF_RED}"$'\uea81'"${_ZF_RESET}"
else
  ICON_CASK="🖥️"
  ICON_PACKAGE="📦"
  ICON_INSTALL="🔧"
  ICON_TRUST="🔓"
  ICON_ERROR="❌"
  ICON_SUCCESS="✅"
  ICON_WARN="⚠"
  ICON_UNINSTALL="🧼"
fi

# Always emoji — preferred over the Nerd Font glyph for this one.
ICON_SEARCH="🍺"

#######################################
# QMK compile repo based
#######################################
function compile_qmk() {
  # Get the root directory of the current Git repo
  REPO_NAME=$(basename $(git rev-parse --show-toplevel) 2>/dev/null)

  # If we're not in a git repo, exit
  if [ -z "$REPO_NAME" ]; then
    echo "Error: Not a git repo"
    exit 1
  fi

  # Choose the compile command based on the repo name
  if [ "$REPO_NAME" = "vial-qmk" ]; then
    echo "Compiling firmware for Cyboard Imprint..."
    qmk compile -kb cyboard/imprint/imprint_number_row -km qc
  elif [ "$REPO_NAME" = "qmk_firmware" ]; then
    echo "Compiling firmware for Sofle..."
    qmk compile -kb sofle/rev1 -km johnend
  else
    echo "Error: Unknown repo"
    exit 1
  fi
}

#######################################
# Yarn and NPM script runner with fzf
#######################################
function run() {
  # Detect and run scripts for JS/TS and Python projects
  if [[ -f package.json ]]; then
    scripts=$(jq -r '.scripts | to_entries[] | "\(.key): \(.value)"' package.json | fzf --height 40%)
    if [[ -n $scripts ]]; then
      script_name="${scripts%%: *}"
      if [[ -f yarn.lock ]]; then
        print -s "yarn run $script_name"
        yarn run "$script_name"
      elif [[ -f package-lock.json ]]; then
        print -s "npm run $script_name"
        npm run "$script_name"
      elif [[ -f pnpm-lock.yaml ]]; then
        print -s "pnpm run $script_name"
        pnpm run "$script_name"
      elif [[ -f bun.lockb ]]; then
        print -s "bun run $script_name"
        bun run "$script_name"
      elif [[ -f deno.json || -f deno.jsonc ]]; then
        print -s "deno task $script_name"
        deno task "$script_name"
      else
        echo "No recognized JS/TS package manager lockfile found."
      fi
    else
      echo "Nothing selected. Exiting $ICON_WAVE"
    fi

  elif [[ -f build.gradle || -f build.gradle.kts || -f settings.gradle || -f settings.gradle.kts ]]; then
    local gradle_cmd
    if [[ -f gradlew ]]; then
      gradle_cmd="./gradlew"
    elif command -v gradle &>/dev/null; then
      gradle_cmd="gradle"
    else
      echo "🚨 Error: no Gradle wrapper (gradlew) or gradle binary found."
      return 1
    fi

    local selected
    selected=$(
      $gradle_cmd tasks 2>&1 \
        | grep -E '^[a-zA-Z][a-zA-Z0-9]* - ' \
        | awk -F ' - ' '{printf "%-35s \033[2m%s\033[0m\n", $1, $2}' \
        | fzf --ansi --height 40% --prompt="$ICON_GRADLE Gradle > "
    )

    if [[ -n "$selected" ]]; then
      local task_name
      task_name=$(echo "$selected" | awk '{print $1}')
      print -s "$gradle_cmd $task_name"
      $gradle_cmd "$task_name"
    else
      echo "Nothing selected. Exiting $ICON_WAVE"
    fi

  else
    echo "🚨 Error: could not find package.json or a Gradle build file"
  fi
}

#######################################
# Make homebrew act like yay
#######################################
function brzf() {
  if [[ "$OSTYPE" != "darwin"* ]]; then
    echo "brzf is only available on macOS."
    return 1
  fi

  if ! command -v brew &>/dev/null; then
    echo "Homebrew is not installed."
    return 1
  fi

  local cmd=""
  local arg=""

  while [[ "$#" -gt 0 ]]; do
    case "$1" in
    --rm | -r)
      cmd="uninstall"
      ;;
    --cask | -c)
      cmd="cask"
      ;;
    --trust | -t)
      cmd="trust"
      ;;
    --help | -h)
      echo "brzf: Interactive Homebrew with fuzzy search"
      echo ""
      echo "Usage:"
      echo "  brzf [query]             Search and install package (default)"
      echo "  brzf -r | --rm           Fuzzy uninstall installed package"
      echo "  brzf -c | --cask [query] Search and install GUI app (cask)"
      echo "  brzf -t | --trust        Fuzzy-trust untrusted installed formulae/casks"
      echo "  brzf -h | --help         Show this help message"
      return 0
      ;;
    *)
      arg="$1"
      ;;
    esac
    shift
  done

  case "$cmd" in
  uninstall)
    local choice
    choice=$(brew list | fzf --ansi --height=40% --prompt="$ICON_UNINSTALL brzf: Uninstall > " --preview 'echo {}')
    [[ -n "$choice" ]] && echo "$ICON_UNINSTALL Uninstalling $choice..." && brew uninstall "$choice" || echo "$ICON_ERROR No package selected."
    ;;

  cask)
    local choice
    choice=$(brew search --casks --desc "$arg" 2>&1 | grep -v 'Warning: Use `--eval-all`' | awk '{printf "\033[1m%s\033[0m \033[2m%s\033[0m\n", $1, substr($0, index($0,$2))}' | fzf --ansi --height=40% --prompt="$ICON_CASK brzf: Cask > ")
    [[ -n "$choice" ]] && pkg=$(echo "$choice" | awk '{print $1}' | sed 's/:$//') && echo "$ICON_PACKAGE Installing cask: $pkg..." && brew install --cask "$pkg" || echo "$ICON_ERROR No cask selected."
    ;;

  trust)
    local receipt tap name
    local -a formula_receipts cask_receipts candidates menu

    # Batch all receipts through one jq call per kind instead of forking jq
    # per file — with ~300 installed formulae, per-file jq forks made this
    # mode take several seconds; batching brings it under a tenth of that.
    formula_receipts=("$(brew --cellar)"/*/*/INSTALL_RECEIPT.json(N))
    if [[ ${#formula_receipts[@]} -gt 0 ]]; then
      while IFS=$'\t' read -r receipt tap; do
        [[ -z "$tap" || "$tap" == "homebrew/core" ]] && continue
        name=$(basename "$(dirname "$(dirname "$receipt")")")
        candidates+=("formula|$tap/$name")
      done < <(jq -r '[input_filename, (.source.tap // "")] | @tsv' "${formula_receipts[@]}" 2>/dev/null)
    fi

    cask_receipts=("$(brew --caskroom)"/*/.metadata/INSTALL_RECEIPT.json(N))
    if [[ ${#cask_receipts[@]} -gt 0 ]]; then
      while IFS=$'\t' read -r receipt tap; do
        [[ -z "$tap" || "$tap" == "homebrew/cask" ]] && continue
        name=$(basename "$(dirname "$(dirname "$receipt")")")
        candidates+=("cask|$tap/$name")
      done < <(jq -r '[input_filename, (.source.tap // "")] | @tsv' "${cask_receipts[@]}" 2>/dev/null)
    fi

    if [[ ${#candidates[@]} -eq 0 ]]; then
      echo "$ICON_SUCCESS Nothing installed from third-party taps."
      return 0
    fi

    # Read trust.json directly rather than `brew trust --json=v1` — skips a
    # full brew/Ruby bootstrap just to read a small local JSON file.
    local trust_file="${XDG_CONFIG_HOME:-$HOME/.config}/homebrew/trust.json"
    [[ -f "$trust_file" ]] || trust_file="$HOME/.homebrew/trust.json"

    local trusted_taps="" trusted_formulae="" trusted_casks=""
    if [[ -f "$trust_file" ]]; then
      trusted_taps=$(jq -r '.trustedtaps[]? // empty' "$trust_file" 2>/dev/null)
      trusted_formulae=$(jq -r '.trustedformulae[]? // empty' "$trust_file" 2>/dev/null)
      trusted_casks=$(jq -r '.trustedcasks[]? // empty' "$trust_file" 2>/dev/null)
    fi

    local entry kind fullname tapname
    for entry in "${candidates[@]}"; do
      kind="${entry%%|*}"
      fullname="${entry#*|}"
      tapname="${fullname%/*}"
      grep -qxF "$tapname" <<<"$trusted_taps" && continue
      [[ "$kind" == "formula" ]] && grep -qxF "$fullname" <<<"$trusted_formulae" && continue
      [[ "$kind" == "cask" ]] && grep -qxF "$fullname" <<<"$trusted_casks" && continue
      menu+=("brew trust --$kind $fullname")
    done

    if [[ ${#menu[@]} -eq 0 ]]; then
      echo "$ICON_SUCCESS Everything installed is already trusted."
      return 0
    fi

    local selected
    selected=$(printf '%s\n' "${menu[@]}" | sort -u | fzf --multi --height=40% --prompt="$ICON_TRUST brzf: Trust > ")

    if [[ -n "$selected" ]]; then
      while IFS= read -r line; do
        print -s "$line"
        eval "$line"
      done <<<"$selected"
    else
      echo "$ICON_ERROR Nothing selected."
    fi
    ;;

  *)
    local choice
    choice=$(brew search --desc "$arg" 2>&1 | grep -v 'Warning: Use `--eval-all`' | awk '{printf "\033[1m%s\033[0m \033[2m%s\033[0m\n", $1, substr($0, index($0,$2))}' | fzf --ansi --height=40% --prompt="$ICON_SEARCH brzf: Install > ")
    [[ -n "$choice" ]] && pkg=$(echo "$choice" | awk '{print $1}' | sed 's/:$//') && echo "$ICON_INSTALL Installing $pkg..." && brew install "$pkg" || echo "$ICON_ERROR No package selected."
    ;;
  esac
}

#######################################
# Clone repo with fzf
#######################################

function cloner() {
  if ! command -v gh &>/dev/null; then
    echo "GitHub CLI is not installed."
    return 1
  fi

  local choice
  choice=$(gh repo list | awk '{printf "\033[1m%s\033[0m \033[2m%s\033[0m\n", $1, substr($0, index($0,$2))}' | fzf --ansi --height=40% --prompt="Choose a repo to clone:" --preview 'echo {}')

  [[ -n "$choice" ]] && repo=$(echo "$choice" | awk '{print $1}') && echo "Cloning $repo..." && gh repo clone "$repo" || echo "No repo selected."
}

#######################################
# Validate ~/.claude.json on shell startup
# Detects the mcpServers serializer bug that wipes user MCPs.
#######################################
function _claude_config_check() {
  local config="$HOME/.claude.json"
  [[ -f "$config" ]] || return 0
  command -v jq >/dev/null 2>&1 || return 0

  if ! jq empty "$config" >/dev/null 2>&1; then
    local latest_valid=""
    for f in "$HOME"/.claude/backups/.claude.json.backup.*(.NOm); do
      if jq empty "$f" >/dev/null 2>&1; then latest_valid="$f"; break; fi
    done
    print -P "%F{red}$ICON_WARN ~/.claude.json is unparseable (MCP serializer bug?)%f"
    [[ -n "$latest_valid" ]] && print -P "%F{yellow}  Latest valid backup: $latest_valid%f"
    print -P "%F{yellow}  Restore: cp \"\$BACKUP\" ~/.claude.json%f"
    return
  fi

  # Detect the specific schema bug even when jq parses (defensive — top-level mcpServers must be object, not array)
  local mcp_type
  mcp_type=$(jq -r '.mcpServers | type' "$config" 2>/dev/null)
  if [[ "$mcp_type" == "array" ]]; then
    print -P "%F{red}$ICON_WARN ~/.claude.json: top-level mcpServers is an array — should be an object%f"
    print -P "%F{yellow}  Fix: jq '.mcpServers = {}' ~/.claude.json > ~/.claude.json.tmp && mv ~/.claude.json.tmp ~/.claude.json%f"
  fi
}
_claude_config_check
